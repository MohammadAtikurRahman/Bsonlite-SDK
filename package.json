{
  "name": "bsonlite-sdk",
  "version": "0.6.0-rc.3",
  "description": "BsonLite: a portable MongoDB-based local database for Node.js and Windows, with BSON queries, native encrypted storage and automatic engine setup. Experimental alpha.",
  "main": "./index.cjs",
  "exports": {
    ".": "./index.cjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "license": "SEE LICENSE IN licenses/SOURCE_AND_NOTICES.md",
  "author": "Atikur Rahman",
  "homepage": "https://bsonlite.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohammadAtikurRahman/Bsonlite-SDK.git"
  },
  "bugs": {
    "url": "https://github.com/MohammadAtikurRahman/Bsonlite-SDK/issues"
  },
  "keywords": [
    "bsonlite",
    "mongodb",
    "database",
    "nodejs",
    "offline",
    "document-database",
    "bson",
    "windows",
    "encrypted-storage",
    "bsonlite-console"
  ],
  "files": [
    "BsonLite.cjs",
    "build-info.json",
    "validation.json",
    "SHA256SUMS.txt",
    "licenses/",
    "source/",
    "SECURITY.md",
    "TEST_RESULTS.md",
    "START_HERE.md",
    "scripts/verify-package.cjs",
    "CHANGELOG.md",
    "index.cjs",
    "auto-console.cjs",
    "CONSOLE.md",
    "console-build.json",
    "examples/",
    "MODERN_ENGINE.md",
    "PUBLISH.md"
  ],
  "scripts": {
    "pretest": "node scripts/verify-package.cjs --normalize",
    "test": "node --test test/npm.test.cjs",
    "verify": "node scripts/verify-package.cjs",
    "test:console": "node scripts/test-console-windows.cjs",
    "test:modern-preparation": "node --test test/modern-preparation.test.cjs",
    "prepack": "node scripts/verify-package.cjs --normalize",
    "prepublishOnly": "node scripts/verify-package.cjs --normalize",
    "release:verify": "node scripts/local-release.cjs verify",
    "release:stage": "node scripts/local-release.cjs stage",
    "test:release": "node --test test/local-release.test.cjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "bsonlite": {
    "sdkVersion": "0.6.0-rc.1",
    "consoleVersion": "0.2.0"
  }
}
